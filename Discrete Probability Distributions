    <!-- APPLICATION LOGIC -->
    <script>
        /* TAB NAVIGATION LOGIC */
        function switchTab(tabId) {
            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.page-module').forEach(mod => mod.classList.remove('active'));

            const selectedNav = Array.from(document.querySelectorAll('.nav-btn')).find(btn => 
                btn.getAttribute('onclick').includes(tabId)
            );
            if (selectedNav) selectedNav.classList.add('active');

            const targetModule = document.getElementById('module-' + tabId);
            if (targetModule) targetModule.classList.add('active');

            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Refresh charts when switching tabs to ensure proper SVG rendering bounds
            if (tabId === 'binomial') updateBinomial();
            if (tabId === 'poisson') updatePoisson();
            if (tabId === 'geometric') updateGeometric();
        }

        /* NUMERICALLY STABLE MATHEMATICAL FUNCTIONS */
        // Natural logarithm of factorial using Lanczos approximation for Gamma function: ln(n!) = ln(Gamma(n+1))
        function logGamma(n) {
            if (n <= 0) return 0;
            const c = [
                76.18009172947146, -86.50532032941677,
                24.01409824083091, -1.231739572450155,
                0.1208650973866179e-2, -0.5395239384953e-5
            ];
            let x = n;
            let y = n;
            let tmp = x + 5.5;
            tmp -= (x + 0.5) * Math.log(tmp);
            let ser = 1.000000000190015;
            for (let j = 0; j <= 5; j++) {
                y += 1;
                ser += c[j] / y;
            }
            return -tmp + Math.log(2.5066282746310005 * ser / x);
        }

        function logFactorial(n) {
            if (n < 0) return 0;
            if (n <= 1) return 0;
            return logGamma(n + 1);
        }

        function logCombination(n, k) {
            if (k < 0 || k > n) return -Infinity;
            if (k === 0 || k === n) return 0;
            return logFactorial(n) - logFactorial(k) - logFactorial(n - k);
        }

        /* BINOMIAL DISTRIBUTION MODULE */
        function calculateBinomialPMF(n, p, k) {
            if (k < 0 || k > n) return 0;
            if (p === 0) return k === 0 ? 1 : 0;
            if (p === 1) return k === n ? 1 : 0;
            const logP = logCombination(n, k) + (k * Math.log(p)) + ((n - k) * Math.log(1 - p));
            return Math.exp(logP);
        }

        function updateBinomial() {
            const nInput = document.getElementById('bin-n');
            const pInput = document.getElementById('bin-p');
            const kPmfInput = document.getElementById('bin-k-pmf');
            const kCdfInput = document.getElementById('bin-k-cdf');

            const n = parseInt(nInput.value);
            const p = parseFloat(pInput.value);

            let valid = true;

            if (isNaN(n) || n < 1 || !Number.isInteger(n)) {
                document.getElementById('bin-n-err').style.display = 'block';
                valid = false;
            } else {
                document.getElementById('bin-n-err').style.display = 'none';
            }

            if (isNaN(p) || p < 0 || p > 1) {
                document.getElementById('bin-p-err').style.display = 'block';
                valid = false;
            } else {
                document.getElementById('bin-p-err').style.display = 'none';
            }

            if (!valid) return;

            document.getElementById('bin-val-n').innerText = n;
            document.getElementById('bin-val-p').innerText = p.toFixed(4);
            document.getElementById('bin-val-q').innerText = (1 - p).toFixed(4);

            // Statistical calculations
            const mean = n * p;
            const variance = n * p * (1 - p);
            const sd = Math.sqrt(variance);
            const m2 = variance + (mean * mean);
            const skewness = (variance === 0) ? "Undefined" : ((1 - 2 * p) / sd).toFixed(4);

            document.getElementById('bin-stat-mean').innerText = mean.toFixed(4).replace(/\.?0+$/, "");
            document.getElementById('bin-stat-var').innerText = variance.toFixed(4).replace(/\.?0+$/, "");
            document.getElementById('bin-stat-sd').innerText = sd.toFixed(4);
            document.getElementById('bin-stat-m2').innerText = m2.toFixed(4).replace(/\.?0+$/, "");
            document.getElementById('bin-stat-skew').innerText = skewness;

            // PMF Calculator
            const kPmf = parseInt(kPmfInput.value);
            if (isNaN(kPmf) || kPmf < 0 || kPmf > n) {
                document.getElementById('bin-k-pmf-err').style.display = 'block';
            } else {
                document.getElementById('bin-k-pmf-err').style.display = 'none';
                const pmfVal = calculateBinomialPMF(n, p, kPmf);
                document.getElementById('bin-pmf-res').innerText = 
                    `P(X = ${kPmf}) = ${pmfVal.toFixed(4)} (${(pmfVal * 100).toFixed(2)}%)`;
            }

            // CDF Calculator
            const kCdf = parseInt(kCdfInput.value);
            if (isNaN(kCdf) || kCdf < 0 || kCdf > n) {
                document.getElementById('bin-k-cdf-err').style.display = 'block';
            } else {
                document.getElementById('bin-k-cdf-err').style.display = 'none';
                let cdfVal = 0;
                for (let i = 0; i <= kCdf; i++) {
                    cdfVal += calculateBinomialPMF(n, p, i);
                }
                cdfVal = Math.min(1.0, cdfVal);
                const compCdf = Math.max(0.0, 1.0 - cdfVal);
                document.getElementById('bin-cdf-res').innerText = 
                    `P(X \u2264 ${kCdf}) = ${cdfVal.toFixed(4)} | P(X > ${kCdf}) = ${compCdf.toFixed(4)}`;
            }

            // Draw Chart
            const data = [];
            for (let i = 0; i <= n; i++) {
                data.push({ x: i, y: calculateBinomialPMF(n, p, i) });
            }
            renderSVGChart('bin-chart', 'bin-tooltip', data, mean, "Number of Successes (X)", "Probability P(X)");
        }

        /* POISSON DISTRIBUTION MODULE */
        function calculatePoissonPMF(lambda, k) {
            if (k < 0) return 0;
            if (lambda === 0) return k === 0 ? 1 : 0;
            const logP = -lambda + (k * Math.log(lambda)) - logFactorial(k);
            return Math.exp(logP);
        }

        function updatePoisson() {
            const lambdaInput = document.getElementById('poi-lambda');
            const kPmfInput = document.getElementById('poi-k-pmf');
            const kCdfInput = document.getElementById('poi-k-cdf');

            const lambda = parseFloat(lambdaInput.value);

            if (isNaN(lambda) || lambda < 0) {
                document.getElementById('poi-lambda-err').style.display = 'block';
                return;
            } else {
                document.getElementById('poi-lambda-err').style.display = 'none';
            }

            document.getElementById('poi-val-lambda').innerText = lambda;

            // Stats
            const mean = lambda;
            const variance = lambda;
            const sd = Math.sqrt(lambda);

            document.getElementById('poi-stat-mean').innerText = mean.toFixed(4).replace(/\.?0+$/, "");
            document.getElementById('poi-stat-var').innerText = variance.toFixed(4).replace(/\.?0+$/, "");
            document.getElementById('poi-stat-sd').innerText = sd.toFixed(4);

            // PMF Calculator
            const kPmf = parseInt(kPmfInput.value);
            if (isNaN(kPmf) || kPmf < 0) {
                document.getElementById('poi-k-pmf-err').style.display = 'block';
            } else {
                document.getElementById('poi-k-pmf-err').style.display = 'none';
                const pmfVal = calculatePoissonPMF(lambda, kPmf);
                document.getElementById('poi-pmf-res').innerText = 
                    `P(X = ${kPmf}) = ${pmfVal.toFixed(4)} (${(pmfVal * 100).toFixed(2)}%)`;
            }

            // CDF Calculator
            const kCdf = parseInt(kCdfInput.value);
            if (isNaN(kCdf) || kCdf < 0) {
                document.getElementById('poi-k-cdf-err').style.display = 'block';
            } else {
                document.getElementById('poi-k-cdf-err').style.display = 'none';
                let cdfVal = 0;
                for (let i = 0; i <= kCdf; i++) {
                    cdfVal += calculatePoissonPMF(lambda, i);
                }
                cdfVal = Math.min(1.0, cdfVal);
                const compCdf = Math.max(0.0, 1.0 - cdfVal);
                document.getElementById('poi-cdf-res').innerText = 
                    `P(X \u2264 ${kCdf}) = ${cdfVal.toFixed(4)} | P(X > ${kCdf}) = ${compCdf.toFixed(4)}`;
            }

            // Dynamic X Range calculation to cover 99.99% mass
            const maxRange = Math.max(12, Math.ceil(lambda + 4 * (Math.sqrt(lambda) || 1)));
            const data = [];
            for (let i = 0; i <= maxRange; i++) {
                data.push({ x: i, y: calculatePoissonPMF(lambda, i) });
            }
            renderSVGChart('poi-chart', 'poi-tooltip', data, mean, "Number of Events (X)", "Probability P(X)");

            // Render Multi-Poisson Comparison Chart
            renderPoissonComparison();
        }

        function renderPoissonComparison() {
            const svg = document.getElementById('poi-comp-chart');
            const tooltip = document.getElementById('poi-comp-tooltip');
            svg.innerHTML = '';

            const lambdas = [
                { l: 2, color: '#2563eb' },
                { l: 6, color: '#10b981' },
                { l: 10, color: '#f59e0b' }
            ];

            const maxX = 22;
            const padding = { top: 30, right: 30, bottom: 40, left: 50 };
            const width = svg.clientWidth || 600;
            const height = svg.clientHeight || 340;

            const plotWidth = width - padding.left - padding.right;
            const plotHeight = height - padding.top - padding.bottom;

            // Maximum probability across all series for scaling Y axis
            let maxY = 0.30; 

            // Axes
            const xAxis = document.createElementNS("http://www.w3.org/2000/svg", "line");
            xAxis.setAttribute("x1", padding.left);
            xAxis.setAttribute("y1", height - padding.bottom);
            xAxis.setAttribute("x2", width - padding.right);
            xAxis.setAttribute("y2", height - padding.bottom);
            xAxis.setAttribute("class", "axis-line");
            svg.appendChild(xAxis);

            // Draw line series for each lambda
            lambdas.forEach(series => {
                let pathD = "";
                for (let x = 0; x <= maxX; x++) {
                    const yVal = calculatePoissonPMF(series.l, x);
                    const cx = padding.left + (x / maxX) * plotWidth;
                    const cy = height - padding.bottom - (yVal / maxY) * plotHeight;

                    pathD += (x === 0 ? "M " : " L ") + cx + " " + cy;

                    // Plot point marker
                    const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
                    circle.setAttribute("cx", cx);
                    circle.setAttribute("cy", cy);
                    circle.setAttribute("r", 4);
                    circle.setAttribute("fill", series.color);
                    circle.style.cursor = "pointer";

                    circle.addEventListener("mousemove", (e) => {
                        tooltip.style.opacity = '1';
                        tooltip.style.left = (e.offsetX + 10) + 'px';
                        tooltip.style.top = (e.offsetY - 25) + 'px';
                        tooltip.innerHTML = `<strong>&lambda; = ${series.l}</strong><br>X = ${x}<br>P(X) = ${yVal.toFixed(4)}`;
                    });
                    circle.addEventListener("mouseleave", () => tooltip.style.opacity = '0');

                    svg.appendChild(circle);
                }

                const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
                path.setAttribute("d", pathD);
                path.setAttribute("fill", "none");
                path.setAttribute("stroke", series.color);
                path.setAttribute("stroke-width", "2.5");
                svg.appendChild(path);
            });

            // X-Axis Labels
            for (let x = 0; x <= maxX; x += 2) {
                const cx = padding.left + (x / maxX) * plotWidth;
                const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
                text.setAttribute("x", cx);
                text.setAttribute("y", height - padding.bottom + 18);
                text.setAttribute("class", "axis-text");
                text.textContent = x;
                svg.appendChild(text);
            }
        }

        /* GEOMETRIC DISTRIBUTION MODULE */
        function calculateGeometricPMF(p, k) {
            if (k < 1) return 0;
            if (p === 1) return k === 1 ? 1 : 0;
            return Math.pow(1 - p, k - 1) * p;
        }

        function updateGeometric() {
            const pInput = document.getElementById('geo-p');
            const kPmfInput = document.getElementById('geo-k-pmf');
            const kCdfInput = document.getElementById('geo-k-cdf');

            const p = parseFloat(pInput.value);

            if (isNaN(p) || p <= 0 || p > 1) {
                document.getElementById('geo-p-err').style.display = 'block';
                return;
            } else {
                document.getElementById('geo-p-err').style.display = 'none';
            }

            document.getElementById('geo-val-p').innerText = p.toFixed(4);

            // Stats
            const mean = 1 / p;
            const variance = (1 - p) / (p * p);
            const sd = Math.sqrt(variance);
            const m2 = (2 - p) / (p * p);
            const skewness = (p === 1) ? "Undefined" : ((2 - p) / Math.sqrt(1 - p)).toFixed(4);

            document.getElementById('geo-stat-mean').innerText = mean.toFixed(4).replace(/\.?0+$/, "");
            document.getElementById('geo-stat-var').innerText = variance.toFixed(4).replace(/\.?0+$/, "");
            document.getElementById('geo-stat-sd').innerText = sd.toFixed(4);
            document.getElementById('geo-stat-m2').innerText = m2.toFixed(4).replace(/\.?0+$/, "");
            document.getElementById('geo-stat-skew').innerText = skewness;

            // PMF Calculator
            const kPmf = parseInt(kPmfInput.value);
            if (isNaN(kPmf) || kPmf < 1) {
                document.getElementById('geo-k-pmf-err').style.display = 'block';
            } else {
                document.getElementById('geo-k-pmf-err').style.display = 'none';
                const pmfVal = calculateGeometricPMF(p, kPmf);
                document.getElementById('geo-pmf-res').innerText = 
                    `P(X = ${kPmf}) = ${pmfVal.toFixed(4)} (${(pmfVal * 100).toFixed(2)}%)`;
            }

            // CDF Calculator
            const kCdf = parseInt(kCdfInput.value);
            if (isNaN(kCdf) || kCdf < 1) {
                document.getElementById('geo-k-cdf-err').style.display = 'block';
            } else {
                document.getElementById('geo-k-cdf-err').style.display = 'none';
                const cdfVal = 1 - Math.pow(1 - p, kCdf);
                const compCdf = Math.pow(1 - p, kCdf);
                document.getElementById('geo-cdf-res').innerText = 
                    `P(X \u2264 ${kCdf}) = ${cdfVal.toFixed(4)} | P(X > ${kCdf}) = ${compCdf.toFixed(4)}`;
            }

            // X Range calculation
            const maxRange = Math.min(30, Math.max(10, Math.ceil(4 / p)));
            const data = [];
            for (let i = 1; i <= maxRange; i++) {
                data.push({ x: i, y: calculateGeometricPMF(p, i) });
            }
            renderSVGChart('geo-chart', 'geo-tooltip', data, mean, "Trial Number of First Success (X)", "Probability P(X)", true);
        }

        /* REUSABLE SVG BAR CHART RENDERER */
        function renderSVGChart(svgId, tooltipId, data, meanVal, xAxisTitle, yAxisTitle, isGeometric = false) {
            const svg = document.getElementById(svgId);
            const tooltip = document.getElementById(tooltipId);
            svg.innerHTML = '';

            const padding = { top: 30, right: 30, bottom: 45, left: 55 };
            const width = svg.clientWidth || 600;
            const height = svg.clientHeight || 340;

            const plotWidth = width - padding.left - padding.right;
            const plotHeight = height - padding.top - padding.bottom;

            const maxY = Math.max(0.1, Math.max(...data.map(d => d.y)) * 1.15);

            // Grid Lines & Y Axis
            const yTicks = 5;
            for (let i = 0; i <= yTicks; i++) {
                const yVal = (maxY / yTicks) * i;
                const cy = height - padding.bottom - (yVal / maxY) * plotHeight;

                const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
                line.setAttribute("x1", padding.left);
                line.setAttribute("y1", cy);
                line.setAttribute("x2", width - padding.right);
                line.setAttribute("y2", cy);
                line.setAttribute("class", "grid-line");
                svg.appendChild(line);

                const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
                text.setAttribute("x", padding.left - 8);
                text.setAttribute("y", cy + 4);
                text.setAttribute("class", "axis-text");
                text.setAttribute("text-anchor", "end");
                text.textContent = yVal.toFixed(3);
                svg.appendChild(text);
            }

            // Axes Lines
            const xAxis = document.createElementNS("http://www.w3.org/2000/svg", "line");
            xAxis.setAttribute("x1", padding.left);
            xAxis.setAttribute("y1", height - padding.bottom);
            xAxis.setAttribute("x2", width - padding.right);
            xAxis.setAttribute("y2", height - padding.bottom);
            xAxis.setAttribute("class", "axis-line");
            svg.appendChild(xAxis);

            const barCount = data.length;
            const barWidth = Math.max(2, (plotWidth / barCount) * 0.65);

            data.forEach((d) => {
                const cx = padding.left + ((d.x - data[0].x + 0.5) / barCount) * plotWidth;
                const barH = (d.y / maxY) * plotHeight;
                const cy = height - padding.bottom - barH;

                const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
                rect.setAttribute("x", cx - barWidth / 2);
                rect.setAttribute("y", cy);
                rect.setAttribute("width", barWidth);
                rect.setAttribute("height", barH);
                rect.setAttribute("class", isGeometric ? "bar bar-geometric" : "bar");
                rect.setAttribute("rx", "2");

                // Hover Tooltip
                rect.addEventListener("mousemove", (e) => {
                    tooltip.style.opacity = '1';
                    tooltip.style.left = (e.offsetX + 10) + 'px';
                    tooltip.style.top = (e.offsetY - 25) + 'px';
                    tooltip.innerHTML = `<strong>X = ${d.x}</strong><br>P(X) = ${d.y.toFixed(4)}`;
                });
                rect.addEventListener("mouseleave", () => tooltip.style.opacity = '0');

                svg.appendChild(rect);

                // X-Axis Labels (sample every few labels if dense)
                const step = Math.ceil(barCount / 25);
                if (d.x % step === 0) {
                    const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
                    text.setAttribute("x", cx);
                    text.setAttribute("y", height - padding.bottom + 18);
                    text.setAttribute("class", "axis-text");
                    text.textContent = d.x;
                    svg.appendChild(text);
                }
            });

            // Vertical Mean Marker Line
            if (meanVal >= data[0].x && meanVal <= data[data.length - 1].x) {
                const meanX = padding.left + ((meanVal - data[0].x + 0.5) / barCount) * plotWidth;

                const meanLine = document.createElementNS("http://www.w3.org/2000/svg", "line");
                meanLine.setAttribute("x1", meanX);
                meanLine.setAttribute("y1", padding.top);
                meanLine.setAttribute("x2", meanX);
                meanLine.setAttribute("y2", height - padding.bottom);
                meanLine.setAttribute("class", "mean-line");
                svg.appendChild(meanLine);

                const meanTag = document.createElementNS("http://www.w3.org/2000/svg", "text");
                meanTag.setAttribute("x", meanX);
                meanTag.setAttribute("y", padding.top - 8);
                meanTag.setAttribute("class", "mean-label");
                meanTag.setAttribute("text-anchor", "middle");
                meanTag.textContent = `\u03BC = ${meanVal.toFixed(2)}`;
                svg.appendChild(meanTag);
            }
        }

